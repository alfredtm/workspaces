    "tab.inactiveForeground": "#8f8f8f",
    "input.background": "#ebebeb",
    "input.foreground": "#171717",
    "input.border": "#dedad1",
    "input.placeholderForeground": "#8f8f8f",
    "dropdown.background": "#ebebeb",
    "dropdown.border": "#dedad1",
    "button.background": "#a855f7",
    "button.foreground": "#f7f5f0",
    "focusBorder": "#a855f766",
    "list.activeSelectionBackground": "#ebebeb",
    "list.inactiveSelectionBackground": "#ebe8e1",
    "list.hoverBackground": "#ebe8e1",
    "list.focusOutline": "#ffffff00",
    "badge.background": "#a855f7",
    "progressBar.background": "#a855f7",
    "textLink.foreground": "#7c3aed",
    "widget.shadow": "#ffffff99",
    "scrollbarSlider.background": "#0000001a",
    "scrollbarSlider.hoverBackground": "#0000002e",

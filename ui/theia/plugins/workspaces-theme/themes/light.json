    "sideBarTitle.foreground": "#8f8f8f",
    "panel.background": "#f7f5f0",
    "panel.border": "#dedad1",
    "activityBar.background": "#f3f1eb",
    "activityBar.foreground": "#171717",
    "statusBar.background": "#f7f5f0",
    "statusBar.foreground": "#8f8f8f",
    "titleBar.activeBackground": "#f7f5f0",
    "titleBar.activeForeground": "#171717",
    "editorGroupHeader.tabsBackground": "#f7f5f0",

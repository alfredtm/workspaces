    "terminal.background": "#f7f5f0",
    "terminal.foreground": "#171717",
    "terminal.ansiCyan": "#15803d",
    "terminal.ansiMagenta": "#a855f7",
    "terminal.ansiRed": "#dc2626",
    "terminal.ansiYellow": "#b45309",
    "notifications.background": "#ebe8e1",
    "notifications.border": "#dedad1",
    "menu.background": "#ebe8e1",
    "menu.border": "#dedad1",
    "menu.selectionBackground": "#a855f733",
    "quickInput.background": "#ebe8e1",
    "sash.hoverBorder": "#a855f7",
    "widget.border": "#dedad1",
    "tree.indentGuidesStroke": "#dedad1",
    "contrastActiveBorder": "#ffffff00",
    "editorOverviewRuler.border": "#ffffff00",
    "scrollbar.shadow": "#ffffff00",
    "editorIndentGuide.background1": "#ececec",
    "editorIndentGuide.activeBackground1": "#d4d4d4",
    "list.activeSelectionForeground": "#171717"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8f8f8f"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#be185d"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#8f8f8f"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#db2777"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#15803d"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#b45309"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#171717"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "scope": [
        "string.template meta.embedded",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#171717"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#7c3aed",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#dc2626"
      }
    }
  ]
}
    "editorCursor.foreground": "#a855f7",
    "editor.selectionBackground": "#a855f740",
    "editor.inactiveSelectionBackground": "#a855f71f",
    "editor.selectionHighlightBackground": "#a855f722",
    "editor.wordHighlightBackground": "#a855f71a",
    "editor.lineHighlightBackground": "#1a1a1d",
    "editor.lineHighlightBorder": "#00000000",
    "editorIndentGuide.background": "#2a2a2a",
    "editorIndentGuide.activeBackground": "#2A4356",
    "editorWhitespace.foreground": "#2a2a2a",
    "editorBracketMatch.background": "#a855f722",
    "editorBracketMatch.border": "#a855f766",
    "editorWidget.background": "#1a1a1d",
